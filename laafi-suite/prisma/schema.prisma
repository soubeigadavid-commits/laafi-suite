generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// 1. MULTI-ÉTABLISSEMENT
// ============================================================

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  locations Location[]
  users     User[]
  customers Customer[]
  branding  Branding?

  @@map("organizations")
}

model Location {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  address        String?
  phone          String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  coworkingSpaces  CoworkingSpace[]
  reservations     Reservation[]
  restaurantZones  RestaurantZone[]
  restaurantTables RestaurantTable[]
  inventoryItems   InventoryItem[]
  stockCounts      StockCount[]
  orders           Order[]
  cashRegisters    CashRegister[]
  expenses         Expense[]
  invoices         Invoice[]
  purchaseOrders   PurchaseOrder[]

  @@index([organizationId])
  @@map("locations")
}

// ============================================================
// 2. IDENTITÉ, RÔLES, SÉCURITÉ
// ============================================================

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  permissions String[] @default([])
  createdAt   DateTime @default(now())

  users User[]

  @@map("roles")
}

model User {
  id                String   @id @default(uuid())
  email             String   @unique
  passwordHash      String?
  firstName         String
  lastName          String
  phone             String?
  organizationId    String?
  roleId            String
  isActive          Boolean  @default(true)
  preferredChannels String[] @default(["PUSH", "EMAIL"])
  createdAt         DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  role         Role          @relation(fields: [roleId], references: [id])

  orders            Order[]
  cashSessions      CashSession[]
  stockMovements    InventoryMovement[]
  stockLosses       StockLoss[]
  expenses          Expense[]
  auditLogs         AuditLog[]
  notifications     Notification[]
  pushSubscriptions PushSubscription[]

  @@index([roleId])
  @@map("users")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  tableName String
  recordId  String?
  oldValues Json?
  newValues Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([tableName, recordId])
  @@map("audit_logs")
}

// ============================================================
// 3. CLIENTS (FICHE UNIQUE COWORKING + RESTAURANT)
// ============================================================

model Customer {
  id                String   @id @default(uuid())
  organizationId    String?
  firstName         String
  lastName          String
  email             String?
  phone             String?
  companyName       String?
  rccm              String?
  ifu               String?
  address           String?
  preferredChannels String[] @default(["EMAIL"])
  createdAt         DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  reservations      Reservation[]
  tableReservations TableReservation[]
  checkins          Checkin[]
  subscriptions     Subscription[]
  orders            Order[]
  invoices          Invoice[]
  payments          Payment[]
  notifications     Notification[]

  @@index([organizationId])
  @@index([lastName, firstName])
  @@map("customers")
}

// ============================================================
// 4. COWORKING
// ============================================================

enum WorkstationStatus {
  AVAILABLE
  RESERVED
  OCCUPIED
  MAINTENANCE
  BLOCKED
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  NO_SHOW
  COMPLETED
}

enum SubscriptionType {
  PASS_DAY
  PASS_10H
  PASS_20H
  PASS_WEEK
  PASS_MONTH
  COMPANY
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  SUSPENDED
}

model CoworkingSpace {
  id          String   @id @default(uuid())
  locationId  String
  name        String   @default("Espace Coworking")
  description String?
  createdAt   DateTime @default(now())

  location     Location      @relation(fields: [locationId], references: [id], onDelete: Cascade)
  workstations Workstation[]

  @@map("coworking_spaces")
}

model Workstation {
  id               String            @id @default(uuid())
  coworkingSpaceId String
  number           Int
  name             String?
  type             String            @default("FIXED")
  status           WorkstationStatus @default(AVAILABLE)
  description      String?
  equipment        String[]          @default([])
  pricePerHour     Decimal?          @db.Decimal(10, 2)
  pricePerDay      Decimal?          @db.Decimal(10, 2)
  pricePerMonth    Decimal?          @db.Decimal(10, 2)
  createdAt        DateTime          @default(now())

  coworkingSpace CoworkingSpace @relation(fields: [coworkingSpaceId], references: [id], onDelete: Cascade)
  reservations   Reservation[]
  checkins       Checkin[]

  @@unique([coworkingSpaceId, number])
  @@index([status])
  @@map("workstations")
}

model Reservation {
  id            String            @id @default(uuid())
  workstationId String
  customerId    String
  locationId    String
  startTime     DateTime
  endTime       DateTime
  status        ReservationStatus @default(CONFIRMED)
  totalPrice    Decimal?          @db.Decimal(12, 2)
  qrCode        String?
  notes         String?
  createdAt     DateTime          @default(now())

  workstation Workstation @relation(fields: [workstationId], references: [id], onDelete: Cascade)
  customer    Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  location    Location    @relation(fields: [locationId], references: [id], onDelete: Cascade)
  checkins    Checkin[]

  @@index([workstationId, startTime])
  @@index([workstationId, endTime])
  @@index([customerId])
  @@index([status, startTime])
  @@map("reservations")
}

model Checkin {
  id             String    @id @default(uuid())
  workstationId  String
  reservationId  String?
  customerId     String
  checkInAt      DateTime  @default(now())
  checkOutAt     DateTime?
  realEndTime    DateTime?
  overrunMinutes Int?      @default(0)
  extraCharge    Decimal?  @db.Decimal(10, 2)
  notes          String?
  createdAt      DateTime  @default(now())

  workstation Workstation  @relation(fields: [workstationId], references: [id], onDelete: Cascade)
  reservation Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  customer    Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([checkInAt])
  @@map("checkins")
}

model Subscription {
  id          String             @id @default(uuid())
  customerId  String
  name        String
  type        SubscriptionType
  hoursCredit Int?
  price       Decimal            @db.Decimal(10, 2)
  status      SubscriptionStatus @default(ACTIVE)
  startDate   DateTime           @default(now())
  endDate     DateTime?
  lastRenewal DateTime?
  createdAt   DateTime           @default(now())

  customer Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  usages   SubscriptionUsage[]

  @@index([customerId, status])
  @@map("subscriptions")
}

model SubscriptionUsage {
  id             String   @id @default(uuid())
  subscriptionId String
  hoursUsed      Decimal? @db.Decimal(6, 2)
  minutesUsed    Int?
  usedAt         DateTime @default(now())
  notes          String?

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("subscription_usage")
}

// ============================================================
// 5. RESTAURANT — ZONES, TABLES, RÉSERVATIONS
// ============================================================

enum TableStatus {
  AVAILABLE
  RESERVED
  OCCUPIED
  CLEANING
  OUT_OF_SERVICE
}

enum TableReservationStatus {
  PENDING
  CONFIRMED
  ARRIVED
  SEATED
  NO_SHOW
  CANCELLED
}

model RestaurantZone {
  id         String   @id @default(uuid())
  locationId String
  name       String
  createdAt  DateTime @default(now())

  location Location          @relation(fields: [locationId], references: [id], onDelete: Cascade)
  tables   RestaurantTable[]

  @@map("restaurant_zones")
}

model RestaurantTable {
  id         String      @id @default(uuid())
  zoneId     String
  locationId String
  number     Int
  capacity   Int         @default(2)
  status     TableStatus @default(AVAILABLE)
  x          Float?
  y          Float?
  width      Float?
  height     Float?
  createdAt  DateTime    @default(now())

  zone         RestaurantZone     @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  location     Location           @relation(fields: [locationId], references: [id], onDelete: Cascade)
  orders       Order[]
  reservations TableReservation[]

  @@unique([locationId, number])
  @@map("restaurant_tables")
}

model TableReservation {
  id         String                 @id @default(uuid())
  tableId    String
  customerId String
  date       DateTime
  guests     Int
  status     TableReservationStatus @default(PENDING)
  notes      String?
  createdAt  DateTime               @default(now())

  table    RestaurantTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  customer Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tableId, date])
  @@map("table_reservations")
}

// ============================================================
// 6. MENU — CATÉGORIES, PRODUITS, VARIANTES, SUPPLÉMENTS
// ============================================================

enum ProductStatus {
  ACTIVE
  INACTIVE
  TEMPORARILY_UNAVAILABLE
}

model ProductCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  products Product[]

  @@map("product_categories")
}

model Product {
  id          String        @id @default(uuid())
  categoryId  String
  name        String
  code        String?       @unique
  description String?
  photoUrl    String?
  price       Decimal       @db.Decimal(10, 2)
  costPrice   Decimal?      @db.Decimal(10, 2)
  taxRate     Decimal       @default(0.18) @db.Decimal(5, 4)
  unit        String        @default("unité")
  available   Boolean       @default(true)
  status      ProductStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())

  category          ProductCategory    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  variants          ProductVariant[]
  modifiers         ProductModifier[]
  orderItems        OrderItem[]
  kitchenOrderItems KitchenOrderItem[]
  recipe            Recipe?

  @@index([categoryId, status])
  @@map("products")
}

model ProductVariant {
  id        String  @id @default(uuid())
  productId String
  name      String
  priceAdj  Decimal @default(0) @db.Decimal(10, 2)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@map("product_variants")
}

model ProductModifier {
  id        String  @id @default(uuid())
  productId String
  name      String
  priceAdj  Decimal @default(0) @db.Decimal(10, 2)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_modifiers")
}

// ============================================================
// 7. RECETTES / FICHES TECHNIQUES
// ============================================================

model Recipe {
  id            String   @id @default(uuid())
  productId     String   @unique
  name          String
  description   String?
  instructions  String?
  yieldQuantity Decimal  @default(1) @db.Decimal(10, 2)
  yieldUnit     String   @default("portion")
  createdAt     DateTime @default(now())

  product Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  items   RecipeItem[]

  @@map("recipes")
}

model RecipeItem {
  id              String  @id @default(uuid())
  recipeId        String
  inventoryItemId String
  quantity        Decimal @db.Decimal(12, 4)
  unit            String

  recipe        Recipe        @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([recipeId])
  @@map("recipe_items")
}

// ============================================================
// 8. COMMANDES
// ============================================================

enum OrderStatus {
  NEW
  PREPARING
  READY
  SERVED
  PAID
  CANCELLED
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum OrderItemStatus {
  NEW
  PREPARING
  READY
  SERVED
  CANCELLED
}

model Order {
  id         String      @id @default(uuid())
  tableId    String?
  customerId String?
  serverId   String?
  locationId String
  status     OrderStatus @default(NEW)
  orderType  OrderType   @default(DINE_IN)
  notes      String?
  subtotal   Decimal     @default(0) @db.Decimal(12, 2)
  taxTotal   Decimal     @default(0) @db.Decimal(12, 2)
  total      Decimal     @default(0) @db.Decimal(12, 2)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  table         RestaurantTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  customer      Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  server        User?            @relation(fields: [serverId], references: [id], onDelete: SetNull)
  location      Location         @relation(fields: [locationId], references: [id], onDelete: Cascade)
  items         OrderItem[]
  orderPayments OrderPayment[]
  payments      Payment[]
  kitchenOrders KitchenOrder[]

  @@index([locationId, createdAt])
  @@index([customerId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id        String          @id @default(uuid())
  orderId   String
  productId String
  variantId String?
  quantity  Int             @default(1)
  unitPrice Decimal         @db.Decimal(10, 2)
  modifiers String[]        @default([])
  comment   String?
  status    OrderItemStatus @default(NEW)
  total     Decimal         @default(0) @db.Decimal(12, 2)

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model OrderPayment {
  id        String        @id @default(uuid())
  orderId   String
  amount    Decimal       @db.Decimal(12, 2)
  method    PaymentMethod
  status    PaymentStatus @default(PENDING)
  reference String?
  createdAt DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_payments")
}

// ============================================================
// 9. CUISINE (KDS)
// ============================================================

enum KitchenStatus {
  NEW
  PREPARING
  READY
  SERVED
  CANCELLED
}

model KitchenOrder {
  id        String        @id @default(uuid())
  orderId   String
  status    KitchenStatus @default(NEW)
  notes     String?
  createdAt DateTime      @default(now())

  order Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items KitchenOrderItem[]

  @@index([status, createdAt])
  @@map("kitchen_orders")
}

model KitchenOrderItem {
  id             String        @id @default(uuid())
  kitchenOrderId String
  productId      String
  quantity       Int           @default(1)
  comment        String?
  status         KitchenStatus @default(NEW)

  kitchenOrder KitchenOrder @relation(fields: [kitchenOrderId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("kitchen_order_items")
}

// ============================================================
// 10. STOCKS
// ============================================================

enum MovementType {
  ENTRY
  EXIT
  TRANSFER
  ADJUSTMENT
  LOSS
  BREAKAGE
  CONSUMPTION
  INVENTORY
  RECIPE_CONSUMPTION
}

model InventoryItem {
  id              String   @id @default(uuid())
  locationId      String?
  supplierId      String?
  code            String?  @unique
  name            String
  category        String
  unit            String   @default("unité")
  currentStock    Decimal  @default(0) @db.Decimal(14, 4)
  minStock        Decimal  @default(0) @db.Decimal(14, 4)
  maxStock        Decimal? @db.Decimal(14, 4)
  unitCost        Decimal  @default(0) @db.Decimal(12, 2)
  storageLocation String?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())

  location   Location?           @relation(fields: [locationId], references: [id], onDelete: SetNull)
  supplier   Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  movements  InventoryMovement[]
  losses     StockLoss[]
  recipeItems RecipeItem[]
  countItems StockCountItem[]

  @@index([active, name])
  @@map("inventory_items")
}

model InventoryMovement {
  id        String       @id @default(uuid())
  itemId    String
  userId    String?
  type      MovementType
  quantity  Decimal      @db.Decimal(14, 4)
  reason    String?
  reference String?
  cost      Decimal?     @db.Decimal(12, 2)
  createdAt DateTime     @default(now())

  item InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([itemId, createdAt])
  @@index([type, createdAt])
  @@map("inventory_movements")
}

model StockCount {
  id          String    @id @default(uuid())
  locationId  String?
  name        String?
  status      String    @default("IN_PROGRESS")
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  location Location?        @relation(fields: [locationId], references: [id], onDelete: SetNull)
  items    StockCountItem[]

  @@map("stock_counts")
}

model StockCountItem {
  id          String   @id @default(uuid())
  countId     String
  itemId      String
  theoretical Decimal  @db.Decimal(14, 4)
  actual      Decimal  @db.Decimal(14, 4)
  variance    Decimal  @db.Decimal(14, 4)
  valueVar    Decimal? @db.Decimal(12, 2)

  count StockCount    @relation(fields: [countId], references: [id], onDelete: Cascade)
  item  InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([countId])
  @@map("stock_count_items")
}

model StockLoss {
  id        String   @id @default(uuid())
  itemId    String
  userId    String?
  quantity  Decimal  @db.Decimal(14, 4)
  reason    String
  value     Decimal? @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  item InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("stock_losses")
}

// ============================================================
// 11. ACHATS / FOURNISSEURS
// ============================================================

enum PurchaseStatus {
  DRAFT
  ORDERED
  PARTIAL
  FULL
  INVOICED
  PAID
  CANCELLED
}

model Supplier {
  id           String   @id @default(uuid())
  name         String
  rccm         String?
  ifu          String?
  phone        String?
  email        String?
  address      String?
  contactName  String?
  paymentTerms String?
  createdAt    DateTime @default(now())

  purchaseOrders PurchaseOrder[]
  goodsReceipts  GoodsReceipt[]
  inventoryItems InventoryItem[]

  @@map("suppliers")
}

model PurchaseOrder {
  id         String         @id @default(uuid())
  supplierId String
  locationId String?
  reference  String?
  status     PurchaseStatus @default(DRAFT)
  total      Decimal        @default(0) @db.Decimal(14, 2)
  createdAt  DateTime       @default(now())

  supplier Supplier            @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  location Location?           @relation(fields: [locationId], references: [id], onDelete: SetNull)
  items    PurchaseOrderItem[]
  receipts GoodsReceipt[]

  @@index([supplierId, createdAt])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String  @id @default(uuid())
  purchaseOrderId  String
  itemId           String?
  itemName         String
  quantity         Decimal @db.Decimal(14, 4)
  unitPrice        Decimal @db.Decimal(12, 2)
  receivedQuantity Decimal @default(0) @db.Decimal(14, 4)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
  @@map("purchase_order_items")
}

model GoodsReceipt {
  id              String   @id @default(uuid())
  purchaseOrderId String?
  supplierId      String
  receivedAt      DateTime @default(now())
  notes           String?

  purchaseOrder PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  supplier      Supplier           @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  items         GoodsReceiptItem[]

  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id        String  @id @default(uuid())
  receiptId String
  itemId    String?
  itemName  String
  quantity  Decimal @db.Decimal(14, 4)

  receipt GoodsReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@map("goods_receipt_items")
}

// ============================================================
// 12. CAISSE
// ============================================================

model CashRegister {
  id         String   @id @default(uuid())
  locationId String
  name       String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  location Location      @relation(fields: [locationId], references: [id], onDelete: Cascade)
  sessions CashSession[]

  @@map("cash_registers")
}

model CashSession {
  id           String    @id @default(uuid())
  registerId   String
  userId       String
  status       String    @default("OPEN")
  initialFund  Decimal   @default(0) @db.Decimal(14, 2)
  finalFund    Decimal?  @db.Decimal(14, 2)
  expectedCash Decimal?  @db.Decimal(14, 2)
  actualCash   Decimal?  @db.Decimal(14, 2)
  variance     Decimal?  @db.Decimal(14, 2)
  openedAt     DateTime  @default(now())
  closedAt     DateTime?

  register  CashRegister   @relation(fields: [registerId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  movements CashMovement[]

  @@index([status, openedAt])
  @@map("cash_sessions")
}

model CashMovement {
  id        String   @id @default(uuid())
  sessionId String
  type      String
  amount    Decimal  @db.Decimal(14, 2)
  reason    String?
  reference String?
  createdAt DateTime @default(now())

  session CashSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@index([type, createdAt])
  @@map("cash_movements")
}

// ============================================================
// 13. DÉPENSES
// ============================================================

model Expense {
  id            String   @id @default(uuid())
  locationId    String?
  userId        String?
  category      String
  amount        Decimal  @db.Decimal(14, 2)
  date          DateTime @default(now())
  description   String?
  receiptUrl    String?
  paymentMethod String?
  reference     String?

  location Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([date])
  @@map("expenses")
}

// ============================================================
// 14. PAIEMENTS & FACTURES
// ============================================================

enum PaymentMethod {
  CASH
  MOBILE_MONEY
  CARD
  BANK_TRANSFER
  ONLINE
  CUSTOMER_ACCOUNT
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}

enum InvoiceType {
  RESTAURANT
  COWORKING
  GLOBAL
  SUBSCRIPTION
  COMPANY
}

enum InvoiceStatus {
  DRAFT
  PENDING
  PARTIALLY_PAID
  PAID
  CANCELLED
  OVERDUE
}

model Payment {
  id         String        @id @default(uuid())
  customerId String?
  orderId    String?
  amount     Decimal       @db.Decimal(14, 2)
  method     PaymentMethod
  status     PaymentStatus @default(PENDING)
  reference  String?
  createdAt  DateTime      @default(now())

  customer Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  order    Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  invoices InvoicePayment[]

  @@index([customerId])
  @@index([createdAt])
  @@map("payments")
}

model Invoice {
  id         String        @id @default(uuid())
  number     String        @unique
  customerId String
  locationId String?
  type       InvoiceType   @default(GLOBAL)
  date       DateTime      @default(now())
  dueDate    DateTime?
  status     InvoiceStatus @default(PENDING)
  subtotal   Decimal       @default(0) @db.Decimal(14, 2)
  taxTotal   Decimal       @default(0) @db.Decimal(14, 2)
  total      Decimal       @default(0) @db.Decimal(14, 2)
  notes      String?
  createdAt  DateTime      @default(now())

  customer Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  location Location?        @relation(fields: [locationId], references: [id], onDelete: SetNull)
  items    InvoiceItem[]
  payments InvoicePayment[]

  @@index([customerId, date])
  @@index([status])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String
  description String
  quantity    Decimal @default(1) @db.Decimal(12, 2)
  unitPrice   Decimal @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)
  itemType    String
  referenceId String?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

model InvoicePayment {
  id        String   @id @default(uuid())
  invoiceId String
  paymentId String
  amount    Decimal  @db.Decimal(14, 2)
  paidAt    DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, paymentId])
  @@map("invoice_payments")
}

// ============================================================
// 15. TAXES ET REMISES
// ============================================================

enum DiscountType {
  PERCENTAGE
  FIXED
}

model Tax {
  id       String  @id @default(uuid())
  name     String  @unique
  rate     Decimal @db.Decimal(5, 4)
  code     String?
  isActive Boolean @default(true)

  @@map("taxes")
}

model Discount {
  id        String       @id @default(uuid())
  name      String
  type      DiscountType @default(PERCENTAGE)
  value     Decimal      @db.Decimal(12, 2)
  code      String?      @unique
  active    Boolean      @default(true)
  startDate DateTime?
  endDate   DateTime?

  @@map("discounts")
}

// ============================================================
// 16. NOTIFICATIONS
// ============================================================

enum NotificationType {
  RESERVATION_CONFIRMATION
  CHECKIN
  CHECKOUT
  PAYMENT
  INVOICE
  SUBSCRIPTION
  ORDER
  AVAILABILITY
  STOCK_ALERT
  SYSTEM
}

model Notification {
  id         String           @id @default(uuid())
  userId     String?
  customerId String?
  type       NotificationType
  title      String
  message    String
  read       Boolean          @default(false)
  sentVia    String[]         @default([])
  createdAt  DateTime         @default(now())

  user     User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
  @@map("notifications")
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String?
  endpoint  String   @unique
  keys      Json
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// ============================================================
// 17. PARAMÈTRES & BRANDING
// ============================================================

model Settings {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model Branding {
  id              String   @id @default(uuid())
  organizationId  String?  @unique
  commercialName  String?
  slogan          String?
  logoUrl         String?
  logoLightUrl    String?
  logoDarkUrl     String?
  faviconUrl      String?
  coverUrl        String?
  phone           String?
  email           String?
  address         String?
  rccm            String?
  ifu             String?
  colorsPrimary   String?
  colorsSecondary String?
  currency        String   @default("XOF")
  updatedAt       DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("branding")
}
